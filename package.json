{
  "name": "clayform",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint --type-aware --deny-warnings && prettier --check .",
    "format": "prettier --write .",
    "check": "npm run typecheck && npm run lint && npm test",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "manifold-3d": "^3.0.1",
    "three": "^0.178.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/three": "^0.178.0",
    "oxlint": "^1.92.0",
    "oxlint-tsgolint": "^7.0.2006",
    "playwright": "^1.61.1",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vite": "^5.4.10",
    "vitest": "^2.1.4"
  }
}
